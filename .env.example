# Copy this file to .env and fill in real values. Never commit .env.

# Your skill's Amazon-assigned ID, e.g. amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Used by flask-ask-sdk's SkillAdapter to verify incoming requests are for this skill.
# Comma-separate multiple IDs if several skills (different invocation names) share this backend.
ALEXA_SKILL_ID=

# Display name spoken back to the user, e.g. "Maximum Radio"
STATION_NAME=Maximum Radio

# HTTPS stream URL (AAC/MP4, MP3, PLS, M3U/M3U8, or HLS) on port 443 with a trusted cert.
STATION_URL=https://hls-01-maximum.hostingradio.ru/maximum/playlist.m3u8

# Local port for the Flask/gunicorn server.
PORT=5000
